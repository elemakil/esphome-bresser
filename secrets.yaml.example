# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — never commit it.
#
# ESPHome looks for secrets.yaml in the same directory as the config file. If you
# drive ESPHome through the Home Assistant add-on rather than the CLI, secrets.yaml
# lives in the add-on's config directory instead, and these keys must be added there.

# --- Network ---
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback access point the device raises if Wi-Fi fails.
# WPA2 requires at least 8 characters.
ap_password: "generate-your-own"

# --- Device access ---
# Home Assistant API encryption key: 32 random bytes, base64-encoded.
# Generate with:  python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If you change this on an already-adopted device, Home Assistant will ask you to
# re-enter the new key before it reconnects.
api_encryption_key: "generate-your-own"

# Password required for over-the-air firmware updates.
ota_password: "generate-your-own"
